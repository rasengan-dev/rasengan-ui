{
  "name": "Rasengan ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter '@rasengan-ui/*' --filter '!@rasengan-ui/site' dev",
    "build": "pnpm packages:build && pnpm --filter '@rasengan-ui/*' --filter '!@rasengan-ui/site' build",
    "registry:build": "pnpm --filter @rasengan-ui/kit registry:build",
    "packages:build": "pnpm --filter @rasengan-ui/data-ui build",
    "start": "pnpm --filter '@rasengan-ui/*' --filter '!@rasengan-ui/site' start",
    "lint": "pnpm -r lint",
    "test": "",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,css,html}\" --write \"**/*.json\" --write \"**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,md,mdx,css,html}\" --check \"**/*.json\" --check \"**/*.{yml,yaml}\"",
    "prepare": "husky",
    "next:dev": "pnpm --filter @rasengan-ui/site dev",
    "playground": "pnpm --filter @rasengan-ui/playground",
    "next:build": "pnpm registry && pnpm --filter @rasengan-ui/site build",
    "registry": "node scripts/registry.mjs",
    "typecheck": "pnpm --filter @rasengan-ui/core --filter @rasengan-ui/villages --filter @rasengan-ui/registry --filter @rasengan-ui/site --filter rasengan-ui typecheck",
    "contrast": "node scripts/contrast.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "axe": "node scripts/axe.mjs"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "packageManager": "pnpm@8.10.0",
  "keywords": [],
  "author": "Dilane Kombou",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "axe-core": "^4.14.0",
    "husky": "^9.1.7",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.7.4"
  },
  "pnpm": {
    "patchedDependencies": {
      "react-syntax-highlighter@16.1.0": "patches/react-syntax-highlighter@16.1.0.patch",
      "rasengan@2.0.0": "patches/rasengan@2.0.0.patch"
    }
  }
}
