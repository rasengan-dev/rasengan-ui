{
	"name": "rasengan-ui",
	"version": "0.0.0",
	"private": true,
	"description": "The Rasengan UI CLI: add components, switch villages and natures, update installed files without losing local edits (RFC-0002, \"CLI\").",
	"type": "module",
	"bin": {
		"rasengan-ui": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p .",
		"dev": "node src/index.ts",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": ">=20.18.0"
	},
	"devDependencies": {
		"@types/node": "^22",
		"typescript": "^5.9.3"
	},
	"license": "MIT",
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"diff": "^9.0.0",
		"node-diff3": "^3.2.1"
	}
}
