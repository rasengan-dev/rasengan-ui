{
	"name": "rasengan-ui",
	"version": "0.1.1",
	"description": "The Rasengan UI CLI: add components, switch villages and natures, update installed files without losing local edits.",
	"keywords": [
		"rasengan",
		"rasengan-ui",
		"components",
		"base-ui",
		"tailwindcss",
		"react",
		"shadcn",
		"registry",
		"cli",
		"mcp"
	],
	"homepage": "https://ui.rasengan.dev/docs/cli",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rasengan-dev/rasengan-ui.git",
		"directory": "packages/cli"
	},
	"bugs": "https://github.com/rasengan-dev/rasengan-ui/issues",
	"author": "Dilane Kombou",
	"type": "module",
	"bin": {
		"rasengan-ui": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node build.mjs",
		"prepack": "node build.mjs",
		"dev": "node src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"src/**/*.test.ts\""
	},
	"engines": {
		"node": ">=20.18.0"
	},
	"devDependencies": {
		"@rasengan-ui/villages": "workspace:*",
		"@types/node": "^22",
		"esbuild": "^0.28.2",
		"typescript": "^5.9.3"
	},
	"license": "MIT",
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"diff": "^9.0.0",
		"node-diff3": "^3.2.1",
		"zod": "^4.6.7"
	}
}
