{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ui.rasengan.dev/schema/village-recipe.json",
	"title": "Rasengan UI village recipe",
	"description": "What a village is made from: a base village and the knobs, traits and overrides that change it. The village engine turns it into a checked CSS file.",
	"type": "object",
	"required": ["name"],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"name": {
			"description": "The village's name: data-village, the file name, and its own nature when the brand is a hue or a colour.",
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{0,39}$",
			"not": { "enum": ["konoha", "kiri", "iwa"] }
		},
		"title": { "type": "string" },
		"description": { "type": "string" },
		"base": { "description": "The village to start from; it gives every value the recipe does not set.", "enum": ["konoha", "kiri", "iwa"], "default": "konoha" },
		"brand": {
			"description": "One of: an existing nature, a hue, or a colour.",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"nature": { "type": "string" },
				"hue": { "type": "number", "minimum": 0, "maximum": 360 },
				"color": { "description": "#rrggbb, #rgb, rgb(r g b) or oklch(L C H).", "type": "string" },
				"exact": { "description": "Refuse rather than move the brand colour when contrast needs it moved.", "type": "boolean" }
			},
			"oneOf": [{ "required": ["nature"] }, { "required": ["hue"] }, { "required": ["color"] }]
		},
		"neutrals": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"hue": { "description": "The hue of the surfaces. Alone, it moves inkHue with it.", "type": "number", "minimum": 0, "maximum": 360 },
				"inkHue": { "description": "The hue of the ink: text and shadows.", "type": "number", "minimum": 0, "maximum": 360 },
				"chroma": { "description": "0 is grey, 1 the contrast level's own tint, 2 twice that.", "type": "number", "minimum": 0, "maximum": 2 }
			}
		},
		"contrast": { "description": "The colour ladder: soft (Kiri's), standard (Konoha's) or high (Iwa's).", "enum": ["soft", "standard", "high"] },
		"radius": { "description": "0 (square) to 1 (very round); 0.5 is 0.625rem.", "type": "number", "minimum": 0, "maximum": 1 },
		"density": { "enum": ["compact", "default", "comfortable"] },
		"depth": { "enum": ["flat", "soft", "raised", "hard"] },
		"motion": { "enum": ["quick", "calm", "gentle"] },
		"border": { "description": "Border width in px.", "enum": [1, 1.5, 2] },
		"fonts": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"body": { "type": "string" },
				"heading": { "type": "string" },
				"code": { "type": "string" }
			}
		},
		"traits": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"tabs": { "enum": ["segmented", "bar"] },
				"highlight": { "enum": ["soft", "inverted"] },
				"focus": { "enum": ["halo", "ring"] },
				"press": { "enum": ["scale", "sink"] },
				"labels": { "enum": ["plain", "capitals", "mono-capitals"] },
				"headings": { "enum": ["plain", "capitals"] },
				"surfaces": { "enum": ["solid", "glass"] },
				"edges": { "enum": ["soft", "ink"] },
				"skeleton": { "enum": ["pulse", "hatched"] }
			}
		},
		"overrides": {
			"description": "Contract tokens, set after everything else. They are never moved by the contrast fixer: one that fails refuses the village.",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"light": { "type": "object", "additionalProperties": { "type": "string" } },
				"dark": { "type": "object", "additionalProperties": { "type": "string" } }
			}
		}
	}
}
