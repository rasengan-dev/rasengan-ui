{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"baseUrl": ".",
		"paths": {
			"@/components/ui/button": [
				"./components/button/button.base.tsx"
			],
			"@/components/ui/checkbox": [
				"./components/checkbox/checkbox.base.tsx"
			],
			"@/components/ui/dialog": [
				"./components/dialog/dialog.base.tsx"
			],
			"@/components/ui/field": [
				"./components/field/field.base.tsx"
			],
			"@/components/ui/input": [
				"./components/input/input.base.tsx"
			],
			"@/components/ui/label": [
				"./components/label/label.base.tsx"
			],
			"@/components/ui/radio-group": [
				"./components/radio-group/radio-group.base.tsx"
			],
			"@/components/ui/select": [
				"./components/select/select.base.tsx"
			],
			"@/components/ui/separator": [
				"./components/separator/separator.base.tsx"
			],
			"@/components/ui/slider": [
				"./components/slider/slider.base.tsx"
			],
			"@/components/ui/switch": [
				"./components/switch/switch.base.tsx"
			],
			"@/components/ui/textarea": [
				"./components/textarea/textarea.base.tsx"
			],
			"@/components/ui/toggle": [
				"./components/toggle/toggle.base.tsx"
			],
			"@/components/ui/toggle-group": [
				"./components/toggle-group/toggle-group.base.tsx"
			],
			"@/lib/utils": [
				"../packages/core/src/utils.ts"
			],
			"@/lib/village-scope": [
				"../packages/core/src/village-scope.tsx"
			]
		}
	},
	"include": [
		"components",
		"blocks"
	]
}
