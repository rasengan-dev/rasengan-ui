			],
			"@/components/ui/card": [
				"../../registry/components/card/card.base.tsx"
			],
			"@/components/ui/checkbox": [
				"../../registry/components/checkbox/checkbox.base.tsx"
			],
			"@/components/ui/dialog": [
				"../../registry/components/dialog/dialog.base.tsx"
			],
			"@/components/ui/field": [
				"../../registry/components/field/field.base.tsx"
			],
			"@/components/ui/input": [
				"../../registry/components/input/input.base.tsx"
